{
  "expo": {
    "name": "LingoAI",
    "slug": "lingoai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "lingoai",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5B21FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.udea.lingoai",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "LingoAI graba tu voz para evaluar tu pronunciación en inglés."
      }
    },
    "android": {
      "package": "com.udea.lingoai",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#5B21FA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "LingoAI graba tu voz para evaluar tu pronunciación en inglés."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
